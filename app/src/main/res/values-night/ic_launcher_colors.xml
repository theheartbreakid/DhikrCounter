    <color name="ic_launcher_rim">#80FFFFFF</color>
    <color name="ic_launcher_sage_start">#5E8979</color>
    <color name="ic_launcher_sage_mid">#86A798</color>
    <color name="ic_launcher_sage_end">#B4CBC0</color>

    <!-- Dial disc: keeps its lightness so the ink keeps its contrast, only softened -->
