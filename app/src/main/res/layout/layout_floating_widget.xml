<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The actual floating bubble (Center) -->
    <!-- Margins are handled dynamically in FloatingCounterService to ensure zero-clipping -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_bubble"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_view_bubble"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Orbiting Action: Minus (Top Left) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_floating_decrease_card"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="invisible"
        android:alpha="0"
        app:cardCornerRadius="16dp"
        app:cardElevation="14dp"
        app:strokeWidth="1.2dp"
        app:strokeColor="#40FFFFFF"
        app:cardBackgroundColor="#CC1A1C1E">
        <ImageButton
            android:id="@+id/btn_floating_decrease"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_input_delete"
            android:contentDescription="Decrease"
            android:padding="6dp"
            android:scaleType="fitCenter"
            app:tint="@android:color/white" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Orbiting Action: Reset (Top Right) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_floating_reset_card"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="invisible"
        android:alpha="0"
        app:cardCornerRadius="16dp"
        app:cardElevation="14dp"
        app:strokeWidth="1.2dp"
        app:strokeColor="#40FFFFFF"
        app:cardBackgroundColor="#CC1A1C1E">
        <ImageButton
            android:id="@+id/btn_floating_reset"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Reset"
            android:padding="6dp"
            android:scaleType="fitCenter"
            app:tint="@android:color/white" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Orbiting Action: Open App (Bottom Center) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_floating_open_app_card"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="invisible"
        android:alpha="0"
        app:cardCornerRadius="16dp"
        app:cardElevation="14dp"
        app:strokeWidth="1.2dp"
        app:strokeColor="#40FFFFFF"
        app:cardBackgroundColor="#CC1A1C1E">
        <ImageButton
            android:id="@+id/btn_floating_open_app"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Open App"
            android:padding="6dp"
            android:scaleType="fitCenter"
            app:tint="@android:color/white" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
